# البصماتُ الذهبيّة بايتاتٌ لا نصّ: core.autocrlf=true كان يقلب LF إلى CRLF في نسخة العمل فتحمرّ
# بوّابةُ بايتات النواة (`golden.rs`) على ويندوز وحده بلا تغييرٍ في المصدر (ذاكرة kernel-gate-line-endings).
# النطاقُ مقصودٌ ضيّقاً: مثبّتاتُ النواة وحدها، كي لا تُقلب ملفّاتُ جبهةٍ أخرى.
packages/kernel/**/fixtures/** -text
*.bin -text
# 5.1ب (09-16): ملفّاتٌ ثنائيّة كان git يحسبها نصّاً (لا NUL في أوّل 8k) فيقلب LF إلى CRLF عند السحب — sample.pdf أحمرَ اختبارَ cargo في الفورك.
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.exe -text
*.dll -text
docs/ export-ignore
work/ export-ignore
# لوحةُ قياس التحكّم (ن10) هارنسُ الصانع: تعتمد على مسبار CDP للمثبَّت ومسارات جهازه — لا تشحن في اللقطة العامّة
scripts/control-board.mjs export-ignore
scripts/control-board-tasks.json export-ignore
# 🔴 المُولَّدُ من مُرمِّز Rust يُقارَن **بايتاً ببايت** بخرج المولِّد (وهو LF)، فقلبُه إلى
# CRLF في نسخة العمل (core.autocrlf=true) يُحمِّر بوّابةَ العقود على كلّ جهاز ويندوز — وقد
# أحمرّها فعلاً: 1276 سطراً مختلفاً، والمحتوى **متطابقٌ حرفاً** بعد نزع CR (مقيس 2026-09-26).
packages/kernel/src/generated/** text eol=lf
# 🔴 قفلُ Bun يُقارَن بما يعيد كتابتَه bun (وهو LF). أُودع بـCRLF، فكان
# `bun install --frozen-lockfile` **يفشل حتماً** على أيّ مضيفٍ غيرِ ويندوز —
# ولم يظهر حتى أوّل تشغيلٍ لـCI (2026-09-26).
bun.lock text eol=lf
# 🔴 حِزَمُ القشرة المولَّدة (‏`bun build` في `packages/desktop/scripts/prepare.ts`)
# ومخطّطاتُ tauri المولَّدة تُكتب بـLF، فتُقلب إلى CRLF في نسخة العمل مع كلّ بناءٍ على
# ويندوز — فيصير كلُّ ملفٍّ منها فرقاً بحجمه في `git status`، ويُخفي التغييرَ الحقيقيّ.
# مقيس 2026-09-27: واحدٌ وعشرون ملفاً هكذا، وفيها سطران حقيقيّان فقط لكلّ ملفّ.
packages/desktop/ui/approval-mount.js text eol=lf
packages/desktop/ui/deliverables-mount.js text eol=lf
packages/desktop/ui/mcp-catalogue.js text eol=lf
packages/desktop/ui/native-terminal.css text eol=lf
packages/desktop/ui/native-terminal.js text eol=lf
packages/desktop/ui/panels.js text eol=lf
packages/desktop/ui/providers.js text eol=lf
packages/desktop/ui/servers-panel.js text eol=lf
packages/desktop/ui/shell.js text eol=lf
packages/desktop/ui/slot-host.js text eol=lf
packages/desktop/ui/tasks-panel.js text eol=lf
packages/desktop/ui/terminal-panel.js text eol=lf
packages/desktop/ui/trajectory-mount.js text eol=lf
packages/desktop/ui/turns.js text eol=lf
packages/desktop/ui/xterm-LICENSE.txt text eol=lf
packages/desktop/src-tauri/gen/schemas/*.json text eol=lf
# وملفّا كارجو لسطح المكتب: كارجو يكتبهما LF، والمخزَّنُ كان CRLF — فكان رفعُ سطرِ
# الإصدار الواحد يحمل فرقاً باثني عشر ألف سطر يُخفي التغييرَ الحقيقيّ (مقيس في 4.0.68).
packages/desktop/src-tauri/Cargo.lock text eol=lf
packages/desktop/src-tauri/Cargo.toml text eol=lf
