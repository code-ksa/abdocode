{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@abdo/migration-v1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "AbdoCode legacy importer that reads old SQLite data without mutation and produces a verified import report.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
