    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@abdo/contracts": "workspace:*",
    "@abdo/event-store": "workspace:*"
  },
  "devDependencies": {
    "@abdo/persistence-sqlite": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
